{
  "name": "ndt-spatial",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "run-p dev server",
    "server": "tsx watch server/src/index.ts",
    "start": "cross-env NODE_ENV=production tsx server/src/index.ts",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "tsx --test tests/*.test.ts server/**/*.test.ts",
    "lint": "oxlint",
    "preview": "vite preview"
  },
