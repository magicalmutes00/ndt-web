# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------

# Neon Postgres connection string (pooled). Without it the API still boots and
# serves the compiled fallback content, but the dashboard cannot save anything.
DATABASE_URL=

# Optional: Neon API token, only needed for the Neon serverless driver's
# authenticated HTTP mode. Leave blank when using a plain connection string.
NEON_AUTH_TOKEN=

PORT=8787
HOST=0.0.0.0
NODE_ENV=development

# ---------------------------------------------------------------------------
# Authentication — Neon Auth (managed Better Auth)
# ---------------------------------------------------------------------------
# Find this in the Neon Console: Project -> Branch -> Auth -> Configuration.
# Without it the dashboard is disabled and only the public site is served.
NEON_AUTH_URL=

# Only needed for the /admin/* user-management calls (sent as x-api-key).
# Used by tooling that provisions accounts; not required to run the dashboard.
NEON_AUTH_ADMIN_API_KEY=

# Comma-separated allowlist of emails permitted to use the dashboard.
# Leave EMPTY and any authenticated Neon Auth user can edit the site — only safe
# if you also control who is allowed to sign up in Neon Auth.
NEON_AUTH_ALLOWED_EMAILS=

# How long a validated session is trusted before re-checking with Neon Auth.
# 0 disables the cache (one upstream call per request).
NEON_AUTH_SESSION_CACHE_SECONDS=30

# Length of the browser session cookie. The Neon session itself may outlive it.
SESSION_TTL_HOURS=12

# Set to "true" when serving over HTTPS so the session cookie is Secure-only.
COOKIE_SECURE=false

# Forwarded to Neon Auth when a sign-in carries no Origin header (curl, scripts).
# Neon Auth requires a trusted Origin on every sign-in, so this — and the site's
# real origin — must be registered as trusted domains in the Neon Console.
PUBLIC_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Neon Object Storage (or any S3-compatible endpoint). Create a credential and a
# bucket in the Neon Console; the bucket's access level determines how images are
# served. A PRIVATE bucket is served through /api/media/file/<key> (stable URL).
# AWS_ENDPOINT_URL_S3=https://<branch-id>.storage.<region>.aws.neon.tech
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FOLDER=uploads

# Force a backend when both are configured: "s3" or "cloudinary".
# Left unset, S3 wins when configured, otherwise Cloudinary.
STORAGE_PROVIDER=

# Lifetime of a presigned upload URL, in seconds.
S3_UPLOAD_URL_TTL_SECONDS=300

# Optional alternative backend. Uploads are server-proxied rather than presigned.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ndt

# ---------------------------------------------------------------------------
# Hosting
# ---------------------------------------------------------------------------

# Serve the built SPA from this process (single-origin deployment). Defaults to
# true when NODE_ENV=production.
SERVE_STATIC=false

# Only needed when the SPA is hosted on a different origin than the API.
# Comma-separated, e.g. http://localhost:3000,https://example.com
CORS_ORIGINS=
